# BoardMind AI — Environment Configuration
#
# Copy this file to .env and fill in your API key.
# The application works in mock mode without any keys set.

# Groq API Key (primary LLM provider — Llama 3.3 70B)
GROQ_API_KEY=your-groq-api-key-here

# Optional: Model name (default: llama-3.3-70b-versatile)
# Falls back to llama-3.1-8b-instant if primary unavailable
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Force a specific provider (groq | openai | mock)
# LLM_PROVIDER=groq

# Optional: Max concurrent LLM calls (default: 4)
# LLM_MAX_CONCURRENT=4

# Optional: OpenAI-compatible provider (legacy alternative)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
